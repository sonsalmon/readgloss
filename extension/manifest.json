{
  "manifest_version": 3,
  "name": "readgloss",
  "version": "0.1.0",
  "description": "영어 단어를 더블클릭하면 한국어 뜻을 보여 줍니다(로컬 다리를 통해 Claude 구독으로 번역).",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:47831/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "readgloss" },
  "commands": {
    "memo-open": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "메모장 열기 / 새 메모"
    },
    "memo-list": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "지난 메모 보기"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["text.js", "settings-core.js", "glossary-core.js", "paragraph-core.js", "annotate-core.js", "content.js", "paragraph.js", "annotate.js", "structure-core.js", "structure.js", "panel.js", "panel-scraps.js", "panel-concepts.js", "panel-words.js", "panel-study.js", "vendor/approx-string-match.js", "scrap-core.js", "scrap.js", "md-list.js", "concept-core.js", "concept.js", "memo-core.js", "study-time-core.js", "study-time.js", "memo-pad.js", "selection-core.js", "selection.js", "opacity.js"],
      "all_frames": false
    }
  ]
}
