{
  "name": "readgloss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "build:dict": "swiftc -O native/macdict.swift -o native/macdict",
    "build:mt": "swiftc -O -parse-as-library native/mt.swift -o native/mt",
    "build:native": "npm run build:dict && npm run build:mt",
    "bench": "node scripts/bench.mjs",
    "export:day": "node scripts/export-day.mjs",
    "export:pending": "node scripts/export-pending.mjs",
    "export:mark": "node scripts/export-mark.mjs",
    "export:scraps": "node scripts/export-scraps.mjs",
    "export:notes": "node scripts/export-notes.mjs",
    "export:concepts": "node scripts/export-concepts.mjs",
    "scraps": "node scripts/scraps-cli.mjs",
    "tasks:recheck": "node scripts/tasks-recheck.mjs",
    "e2e": "node e2e/youtube.e2e.mjs"
  }
}
